{
  "name": "@tuwaio/configurator-check",
  "private": true,
  "description": "Type-checks every stack the Stack Configurator of the docs hub generates, and every variant of the Nova customization of the Playground, against the published TUWA packages. Outside the pnpm workspace: install it with `pnpm install --ignore-workspace` in this folder.",
