{
  "name": "@tuwaio/docs-ui",
  "version": "0.7.0",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "Shared UI of the TUWA documentation sites: Nextra navbar, footer and layout in English, Ukrainian and Simplified Chinese, remote logo, theme and language switches, background effects, policy pages and styles.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tuwa-docs-search-index": "./bin/search-index.js",
    "tuwa-docs-i18n-check": "./bin/i18n-check.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./policies": {
      "types": "./dist/policies.d.ts",
      "import": "./dist/policies.js",
      "require": "./dist/policies.cjs"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js",
      "require": "./dist/locale.cjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "require": "./dist/i18n.cjs"
    },
    "./nextra": {
      "types": "./dist/nextra.d.ts",
      "import": "./dist/nextra.js",
      "require": "./dist/nextra.cjs"
    },
    "./nextra/page": {
      "types": "./dist/docsPage.d.ts",
      "import": "./dist/docsPage.js",
      "require": "./dist/docsPage.cjs"
    },
    "./dist/index.css": "./dist/index.css",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "socket.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && pnpm exec postcss src/styles/general.css -o ./dist/index.css"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "ui-kit",
    "utils",
    "tuwa",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/docs.git",
    "directory": "packages/docs-ui"
  },
  "homepage": "https://github.com/TuwaIO/docs",
  "bugs": {
    "url": "https://github.com/TuwaIO/docs/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "dependencies": {
    "@tuwaio/nova-core": "^0.10.6",
    "clsx": "^2.1.1",
    "html-react-parser": "^6.1.9",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@heroicons/react": ">=2",
    "next": ">=16.1",
    "nextra": ">=4.6",
    "nextra-theme-docs": ">=4.6",
    "react": ">=19.2.3"
  },
  "devDependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "next": "16.4.3",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "react": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "6.0.3"
  }
}
